# ─── DEMO MODE ───────────────────────────────────────────────────────────────
# This project runs fully in static/demo mode by default.
# No Supabase connection is required to run the demo.
# All data is defined in lib/static-data.ts

# Only fill these in if you want to connect a real Supabase database:
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
